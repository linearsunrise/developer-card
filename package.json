{
  "name": "developer-card",
  "version": "0.1.0",
  "private": true,
  "description": "A read-only developer profile API",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "start:dev": "node --watch dist/src/main.js",
    "build:watch": "tsc --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/prisma/seed.js",
    "start:ready": "npm run db:migrate && npm run db:seed && npm start",
    "test": "npm run build && node --test dist/test/*.spec.js",
    "test:integration": "npm run build && node --test dist/test/*.integration.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test"
  },
  "dependencies": {
    "@apollo/server": "5.5.2",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.2.1",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/graphql": "14.2.1",
    "@nestjs/platform-express": "12.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dataloader": "2.2.3",
    "dotenv": "18.0.10",
    "graphql": "16.15.0",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "overrides": {
    "@graphql-tools/utils": "12.1.0",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "typescript": "5.9.3"
  }
}
